{
  "name": "makrillsverige",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=8192 --expose-gc && next dev",
    "build": "set NODE_OPTIONS=--max-old-space-size=8192 --expose-gc && next build",
    "start": "next start",
    "lint": "next lint",
    "generate:grid": "ts-node scripts/generateGrid.ts",
    "fetch:area-parameters": "tsx scripts/fetchAreaParametersExtended.ts",
    "optimize:images": "python scripts/convert_images_to_webp.py --remove-png",
    "optimize:images:keep-png": "python scripts/convert_images_to_webp.py",
    "optimize:images:quality": "python scripts/convert_images_to_webp.py --quality 80 --remove-png",
    "optimize:images:aggressive": "python scripts/convert_images_to_webp.py --quality 75 --remove-png",
    "mobile:optimize": "npm run optimize:images && echo '📱 Mobil-optimering slutförd! Ladda om sidan för att se förbättringarna.'",
    "cache:clear": "echo 'Rensa cache genom att ladda om med Ctrl+Shift+R (Windows/Linux) eller Cmd+Shift+R (Mac)'",
    "build:everything": "python scripts/build_everything.py",
    "build:quick": "python scripts/build_everything.py --quick 24",
    "build:force": "python scripts/build_everything.py --force",
    "build:current": "python scripts/build_everything.py --parameter current",
    "build:temperature": "python scripts/build_everything.py --parameter temperature",
    "build:salinity": "python scripts/build_everything.py --parameter salinity",
    "build:mackerel": "python scripts/build_everything.py --parameter mackerel",
    "build:hq": "python scripts/build_everything.py --quality 95",
    "build:fast": "python scripts/build_everything.py --quality 75",
    "fetch-weather-yr": "node --loader ts-node/esm scripts/fetchWeatherDataYr.ts",
    "test-yr-api": "node --loader ts-node/esm scripts/test-yr-api.ts",
    "test-viss-api": "tsx scripts/test-viss-api.ts",
    "test-viss-arcgis": "tsx scripts/test-viss-arcgis.ts",
    "test-viss-water": "tsx scripts/test-viss-water-services.ts",
    "test-complete-water-data": "tsx scripts/test-complete-water-data.ts",
    "demo-water-api": "tsx scripts/demo-water-api.ts",
    "fetch-weather-optimized": "node --loader ts-node/esm scripts/weather-data-fetcher.js",
    "fetch-weather-osm": "node --max-old-space-size=4096 --loader ts-node/esm scripts/weather-data-fetcher-with-osm.js",
    "fetch-water-bodies": "node --max-old-space-size=8192 --expose-gc --loader ts-node/esm scripts/fetch-water-bodies-osm.js",
    "save-water-to-db": "node --loader ts-node/esm scripts/save-water-bodies-to-database.js",
    "fetch-weather-db": "node --loader ts-node/esm scripts/weather-data-fetcher-with-database.js",
    "process-unified-waterways": "tsx scripts/run_unified_processing.ts",
    "process-unified-quick": "tsx scripts/run_unified_processing.ts --yes",
    "test-unified-search": "tsx scripts/test_unified_search.ts",
    "test-unified-click": "tsx scripts/test_unified_search.ts click",
    "test-unified-viss": "tsx scripts/test_unified_search.ts viss",
    "test-unified-concept": "tsx scripts/test_unified_concept.ts",
    "create-unified-tables": "tsx scripts/create_unified_tables.ts",
    "create-basic-unified": "tsx scripts/create_basic_unified_table.ts",
    "setup-unified-tables": "tsx scripts/setup_unified_system.ts",
    "setup-unified-complete": "tsx scripts/setup_unified_system.ts complete",
    "debug-processing": "tsx scripts/debug_water_processing.ts",
    "fix-unified-processing": "tsx scripts/fixed_unified_processor.ts",
    "complete-unified-processing": "tsx scripts/complete_unified_processor.ts",
    "simple-all-waterways": "tsx scripts/simple_all_waterways_processor.ts",
    "investigate-db": "tsx scripts/investigate_database_limits.ts",
    "cursor-all-waterways": "tsx scripts/cursor_all_waterways_processor.ts",
    "fast-cached-waterways": "tsx scripts/fast_cached_waterways_processor.ts",
    "sql-unified-waterways": "echo 'Kör SQL-scriptet manuellt i Supabase SQL Editor: sql/populate_unified_waterways_fast.sql'"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.52.0",
    "@turf/area": "^7.2.0",
    "@turf/bbox": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/turf": "^7.2.0",
    "@types/cheerio": "^0.22.35",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.20",
    "@types/maplibre-gl": "^1.13.2",
    "@types/pako": "^2.0.3",
    "animejs": "^4.0.2",
    "apexcharts": "^5.3.1",
    "cheerio": "^1.1.2",
    "chroma-js": "^3.1.2",
    "dotenv": "^16.6.1",
    "grib2-simple": "^1.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "maplibre-gl": "^5.6.1",
    "netcdfjs": "^3.0.0",
    "next": "15.3.3",
    "node-fetch": "^3.3.2",
    "p-limit": "^6.2.0",
    "pako": "^2.1.0",
    "proj4": "^2.19.10",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-circular-input": "^0.2.4",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/chroma-js": "^3.1.1",
    "@types/node": "^20.19.8",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
